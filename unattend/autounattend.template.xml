<?xml version="1.0" encoding="utf-8"?>
<!--
  LiteWin 자동 응답 파일 (템플릿). Build-LiteWin.ps1 이 {{...}} 를 채워 ISO 루트에 autounattend.xml 로 넣는다.

  일부러 하지 않는 것:
   - 디스크 자동 포맷/파티션: 실수로 다른 디스크를 지우지 않도록 설치 위치는 직접 고른다.
   - 계정/비밀번호 하드코딩: OOBE 에서 로컬 계정을 직접 만든다(MS 계정 강제 화면은 숨김).
   - 정품 키 포함: 아래 키는 Microsoft 가 공개한 Pro "에디션 선택용 일반 설치 키"이며 정품 인증은 되지 않는다.
     설치 후 본인 Pro 라이선스(디지털 라이선스 자동 인식 또는 설정 > 정품 인증에서 키 입력)로 인증된다.
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
  <settings pass="windowsPE">
    <component name="Microsoft-Windows-International-Core-WinPE" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <SetupUILanguage>
        <UILanguage>{{UILANG}}</UILanguage>
      </SetupUILanguage>
      <InputLocale>{{INPUT}}</InputLocale>
      <SystemLocale>{{LOCALE}}</SystemLocale>
      <UILanguage>{{UILANG}}</UILanguage>
      <UserLocale>{{LOCALE}}</UserLocale>
    </component>
    <component name="Microsoft-Windows-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <UserData>
        <AcceptEula>true</AcceptEula>
        <ProductKey>
          <Key>VK7JG-NPHTM-C97JM-9MPGT-3V66T</Key>
          <WillShowUI>OnError</WillShowUI>
        </ProductKey>
      </UserData>
      <!--BYPASS_PE-->
    </component>
  </settings>

  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-International-Core" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <InputLocale>{{INPUT}}</InputLocale>
      <SystemLocale>{{LOCALE}}</SystemLocale>
      <UILanguage>{{UILANG}}</UILanguage>
      <UserLocale>{{LOCALE}}</UserLocale>
    </component>
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <TimeZone>{{TIMEZONE}}</TimeZone>
      <Themes>
        <!-- 새 계정 기본 테마 (배경 wave_light + 라이트 모드). 설정 > 개인 설정 > 테마 에서 LiteWin 다크/리본/도형 으로 바꿀 수 있다 -->
        <CustomDefaultThemeFile>%WINDIR%\Resources\Themes\LiteWinLight.theme</CustomDefaultThemeFile>
      </Themes>
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideLocalAccountScreen>true</HideLocalAccountScreen>
        <ProtectYourPC>3</ProtectYourPC>
      </OOBE>
      <!-- 계정: 임시 설정 계정 'LiteWinSetup'(관리자 그룹, 암호 없음)으로 처음 한 번 자동 로그인한다.
           LiteWin 설정 마무리 화면이 'Administrator 로 사용할지' → '로컬 계정 만들기' 순서로 묻고,
           고른 계정으로 로그인하면 이 임시 계정은 지워진다. (Windows OOBE 는 계정 전에 OEM 페이지를 넣을 수 없음) -->
      <UserAccounts>
        <LocalAccounts>
          <LocalAccount wcm:action="add">
            <Name>LiteWinSetup</Name>
            <Group>Administrators</Group>
            <DisplayName>LiteWin 설정</DisplayName>
            <Password><Value></Value><PlainText>true</PlainText></Password>
          </LocalAccount>
        </LocalAccounts>
      </UserAccounts>
      <AutoLogon>
        <Enabled>true</Enabled>
        <LogonCount>1</LogonCount>
        <Username>LiteWinSetup</Username>
        <Password><Value></Value><PlainText>true</PlainText></Password>
      </AutoLogon>
      <FirstLogonCommands>
        <SynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Description>LiteWin first logon (per-user tweaks, Mac style)</Description>
          <CommandLine>powershell.exe -NoProfile -ExecutionPolicy Bypass -File C:\Windows\Setup\Scripts\FirstLogon.ps1</CommandLine>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>
      </FirstLogonCommands>
    </component>
  </settings>
</unattend>
